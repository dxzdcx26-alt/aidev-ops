# AI Dev Control Center — Environment Variables
# ============================================================
# Per spec Phase 1 + §72-73:
#   - NEVER commit real keys
#   - NEVER use NEXT_PUBLIC_ prefix for secrets (only for non-secret public URLs)
#   - All tokens server-side only
#   - Copy this file to .env and fill in real values
# ============================================================

# ============ GitHub (Phase 2, V3 §9-11) ============
# Personal Access Token or GitHub App token. Server-side only.
# Required scopes: repo (contents, pull requests, actions, checks), read:org, workflow
# Create at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# ============ AI Provider (Phase 4, V4 §22) ============
# OpenAI-compatible endpoint. Must be HTTPS and in the provider allowlist.
# Allowed hosts: api.z.ai, api.chatglm.cn, openrouter.ai, api.openai.com, api.deepseek.com, api.anthropic.com
# Default: Z.ai (https://api.z.ai/api/paas/v4)
AI_BASE_URL=https://api.z.ai/api/paas/v4
AI_API_KEY=
# Model name (provider-specific):
#   Z.ai: glm-4.6
#   OpenRouter: anthropic/claude-3.5-sonnet
#   DeepSeek: deepseek-chat
#   OpenAI: gpt-4o
AI_MODEL=glm-4.6

# ============ Vercel (Phase 10, Production §55) ============
# Create at: https://vercel.com/account/tokens
VERCEL_TOKEN=
# Find at: Vercel Dashboard → Team Settings → General → Team ID
VERCEL_TEAM_ID=
# Find at: Project Settings → General → Project ID
VERCEL_PROJECT_ID=

# ============ App URL (Phase 1) ============
# Public URL of this deployment. Used for OAuth callbacks, verification URLs, audit log links.
# Safe to expose to client (non-secret).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============ Auto-Fix Retry Limit (Phase 4 §62) ============
# Maximum AI auto-fix attempts before giving up. Prevents infinite loops.
MAX_AUTO_RETRY=3

# ============ API Rate Limit (Phase 10) ============
# Per-client request limit per minute for /api/* routes (default fallback)
API_RATE_LIMIT_PER_MINUTE=60

# ============ Session Security (Phase 1) ============
# MANDATORY for production: cryptographically random secret used to sign session cookies.
# Generate with: openssl rand -hex 32
# If not set, the system falls back to DATABASE_URL (NOT secure for production).
# The production-readiness check will report BLOCKED if this is not set in production.
SESSION_SECRET=

# ============ Admin Password (Phase 1) ============
# Password for the default admin user created on first boot.
# REQUIRED in production. Must be at least 16 characters and not a common weak password.
# Development may generate a random bootstrap password when this is omitted.
# NEVER hardcode this in source control — set it via environment variable.
CONTROL_CENTER_ADMIN_PASSWORD=

# ============ Database (SQLite — not Neon) ============
# Local file database. Admin / session / audit live in this file.
DATABASE_URL=file:./db/adcc.db
